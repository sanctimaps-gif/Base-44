  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm install && npm run build -w @base44/web",
  "outputDirectory": "./packages/web/dist",
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["cdg1"],
  "functions": {
    "api/**": {
      "maxDuration": 60
    }
  }
}
