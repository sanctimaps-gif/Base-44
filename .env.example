# ---------------------------------------------------------------------------
# Base 44 — configuration
# ---------------------------------------------------------------------------
# Aucune cle d'IA externe n'est requise. Le moteur `@base44/engine` fonctionne
# entierement hors ligne : il n'appelle aucun service d'IA tiers.
# ---------------------------------------------------------------------------

# Port de l'API
PORT=844

# Repertoire de stockage des donnees (JSON)
DATA_DIR=./data

# Origine autorisee pour le front-end
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# OPTIONNEL — adaptateurs de modeles externes.
# Laisser vide conserve l'IA 100 % autonome (mode par defaut).
# Valeurs possibles : "native" (defaut), ou le nom d'un adaptateur enregistre.
# ---------------------------------------------------------------------------
BASE44_AI_PROVIDER=native
